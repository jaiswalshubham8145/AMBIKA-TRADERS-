# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API

# Project URL (public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Public Key (safe to expose in client browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (OPTIONAL / SECRET - only for server-side operations, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Admin UPI Payment Configuration
VITE_ADMIN_UPI_ID=adoreandaura@upi
VITE_ADMIN_UPI_NAME=Adore & Aura

# Admin WhatsApp Alert Configuration
# Phone number with country code (e.g. 91 for India, no + or spaces)
VITE_ADMIN_WHATSAPP_PHONE=919876543210

# Optional: CallMeBot Free WhatsApp API key (if using automated background WhatsApp messages)
# Get free key in 10 seconds: https://www.callmebot.com/blog/free-api-whatsapp-messages/
VITE_CALLMEBOT_API_KEY=
